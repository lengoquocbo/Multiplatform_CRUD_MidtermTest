rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && request.auth.uid in ['EDYSRz60IQVAF7wOZbmBvlRS2643'];
    }
    function validProduct() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'price', 'soluong', 'image'])
        && d.keys().hasOnly(['name', 'price', 'soluong', 'image'])
        && d.name is string && d.name.size() > 0
        && d.name.matches('^\\S([\\s\\S]*\\S)?$')
        && d.price is number && d.price >= 0 && d.price - d.price == 0
        && d.soluong is int && d.soluong >= 0 && d.soluong <= 9007199254740991
        && d.image is string && (
          (d.image.size() <= 2048 && d.image.matches('https://[^/\\s@?#]+([/?#][^\\s]*)?'))
          || (d.image.size() <= 204823 && d.image.matches('data:image/jpeg;base64,/9j/[A-Za-z0-9+/]*={0,2}'))
        );
    }
    match /products/{productId} {
      allow read, delete: if admin();
      allow create, update: if admin() && validProduct();
    }
  }
}
